void setPosition1(double pos1, double period_s) {
  disableDiagnostics = true;  // Disable diagnostics during position command
  
  // Set up query format to request trajectory_complete
  Moteus::Query::Format query_fmt;
  query_fmt.mode = Moteus::kInt8;
  query_fmt.position = Moteus::kFloat;
  query_fmt.velocity = Moteus::kFloat;
  query_fmt.trajectory_complete = Moteus::kInt8;
  
  position_cmd1.position = pos1;
  int loop_count = 0;
  unsigned long start_time = millis();
  const unsigned long TIMEOUT_MS = 10000;  // 10 second timeout
  
  Serial.print(F("Moving M1 to: "));
  Serial.println(pos1, 3);
  
  while (true) {
    const bool got_result1 = moteus1.SetPosition(position_cmd1, &position_fmt, &query_fmt);
    loop_count++;
    
    // Check for timeout
    if (millis() - start_time > TIMEOUT_MS) {
      Serial.println(F("Motor 1 timeout!"));
      return;
    }
    
    if (loop_count % 10 == 0) {  // Print every 10 loops (more frequent)
      Serial.print(F("M1: got="));
      Serial.print(got_result1);
      Serial.print(F(" traj="));
      Serial.print(moteus1.last_result().values.trajectory_complete);
      Serial.print(F(" pos="));
      Serial.println(moteus1.last_result().values.position, 3);
    }
    
    if (got_result1 && moteus1.last_result().values.trajectory_complete) {
      Serial.println(F("Motor 1 completed!"));
      disableDiagnostics = false;  // Re-enable diagnostics
      return;
    }

    delay(10);  // Fixed 10ms delay instead of 1ms
  }
  
  disableDiagnostics = false;  // Re-enable diagnostics even on timeout
}

void setPosition2(double pos2, double period_s) {
  disableDiagnostics = true;  // Disable diagnostics during position command
  
  // Set up query format to request trajectory_complete
  Moteus::Query::Format query_fmt;
  query_fmt.mode = Moteus::kInt8;
  query_fmt.position = Moteus::kFloat;
  query_fmt.velocity = Moteus::kFloat;
  query_fmt.trajectory_complete = Moteus::kInt8;
  
  position_cmd2.position = pos2;
  int loop_count = 0;
  unsigned long start_time = millis();
  const unsigned long TIMEOUT_MS = 10000;  // 10 second timeout
  
  Serial.print(F("Moving M2 to: "));
  Serial.println(pos2, 3);
  
  while (true) {
    const bool got_result2 = moteus2.SetPosition(position_cmd2, &position_fmt, &query_fmt);
    loop_count++;
    
    // Check for timeout
    if (millis() - start_time > TIMEOUT_MS) {
      Serial.println(F("Motor 2 timeout!"));
      return;
    }
    
    if (loop_count % 10 == 0) {  // Print every 10 loops (more frequent)
      Serial.print(F("M2: got="));
      Serial.print(got_result2);
      Serial.print(F(" traj="));
      Serial.print(moteus2.last_result().values.trajectory_complete);
      Serial.print(F(" pos="));
      Serial.println(moteus2.last_result().values.position, 3);
    }
    
    if (got_result2 && moteus2.last_result().values.trajectory_complete) {
      Serial.println(F("Motor 2 completed!"));
      disableDiagnostics = false;  // Re-enable diagnostics
      return;
    }

    delay(10);  // Fixed 10ms delay instead of 1ms
  }
  
  disableDiagnostics = false;  // Re-enable diagnostics even on timeout
}

void printDiagnostics() {
  const auto& v1 = moteus1.last_result().values;
  const auto& v2 = moteus2.last_result().values;
  
  Serial.print(F("M1_abs="));
  Serial.print(v1.abs_position, 6);
  Serial.print(F(" | M2_abs="));
  Serial.print(v2.abs_position, 6);
  Serial.println();
}

void oscillateMotors() {
  // VELOCITY CONTROL based on external encoder feedback (like basilisk code)
  
  Serial.println(F("=== Oscillation Mode (Velocity Control) ==="));
  Serial.println(F("Using external encoder feedback - Type 'stop' to exit"));
  
  // Query format to get abs_position (external encoder)
  Moteus::Query::Format query_fmt;
  query_fmt.mode = Moteus::kInt8;
  query_fmt.position = Moteus::kFloat;
  query_fmt.velocity = Moteus::kFloat;
  query_fmt.abs_position = Moteus::kFloat;  // External AS5600 encoder
  query_fmt.fault = Moteus::kInt8;
  
  // Set query format for both motors
  moteus1.SetQuery(&query_fmt);
  moteus2.SetQuery(&query_fmt);
  delay(50);
  
  // Get starting positions (both motor and external encoder)
  double start_ext1 = moteus1.last_result().values.abs_position;
  double start_ext2 = moteus2.last_result().values.abs_position;
  double start_mpos1 = moteus1.last_result().values.position;
  double start_mpos2 = moteus2.last_result().values.position;
  
  Serial.print(F("Start M1: mpos="));
  Serial.print(start_mpos1, 3);
  Serial.print(F(" ext="));
  Serial.print(start_ext1, 4);
  Serial.print(F(" | M2: mpos="));
  Serial.print(start_mpos2, 3);
  Serial.print(F(" ext="));
  Serial.println(start_ext2, 4);
  
  // Check if motors are in mode 11 (stuck at limits)
  if ((int)moteus1.last_result().values.mode == 11 || 
      (int)moteus2.last_result().values.mode == 11) {
    Serial.println(F("*** ERROR: Motors in Mode 11 (stuck at limits) ***"));
    Serial.println(F("Manually reposition motors away from limits first"));
    Serial.println(F("Recommended: M1 and M2 to positions where ext encoders are 0.15-0.35"));
    return;
  }
  
  // Very small oscillation range to stay within motor position limits (±0.05 ext = ±1.05 motor revs)
  const double OSCILLATION_AMPLITUDE = 0.05;
  const double TARGET_LOW_1 = start_ext1 - OSCILLATION_AMPLITUDE;
  const double TARGET_HIGH_1 = start_ext1 + OSCILLATION_AMPLITUDE;
  const double TARGET_LOW_2 = start_ext2 - OSCILLATION_AMPLITUDE;
  const double TARGET_HIGH_2 = start_ext2 + OSCILLATION_AMPLITUDE;
  
  Serial.print(F("Oscillation range: M1["));
  Serial.print(TARGET_LOW_1, 3);
  Serial.print(F(" to "));
  Serial.print(TARGET_HIGH_1, 3);
  Serial.print(F("] M2["));
  Serial.print(TARGET_LOW_2, 3);
  Serial.print(F(" to "));
  Serial.print(TARGET_HIGH_2, 3);
  Serial.println(F("]"));
  const double MAX_VELOCITY = 0.5;   // Maximum velocity (not used in position mode)
  const double MAX_ACCELERATION = 0.2;  // Maximum acceleration (not used in position mode)
  const double DAMPING_THRESHOLD = 0.05;  // Not used in position mode
  const double FIX_THRESHOLD = 0.015;  // Consider reached when within 0.015 revolutions
  const double GEAR_RATIO = 21.0;    // Motor revolutions per external encoder revolution (from basilisk)
  
  int loop_count = 0;
  unsigned long start_time = millis();
  
  Serial.println(F("Using continuous sine wave velocity like BasicControl"));
  
  while (true) {
    // Check for stop command
    if (Serial.available()) {
      String val = Serial.readStringUntil('\n');
      if (val.indexOf("stop") != -1) {
        Serial.println(F("Stopping..."));
        moteus1.SetStop();
        moteus2.SetStop();
        return;
      }
    }
    
    // Use sine wave velocity like BasicControl - motors oscillate continuously
    const auto time = millis() - start_time;
    const double period_ms = 4000.0;  // 4 second period for full oscillation cycle
    const double max_velocity = 0.5;  // Maximum velocity in rev/s
    
    // Calculate velocity using sine wave (opposite phases for M1 and M2)
    double velocity1 = max_velocity * sin(2.0 * M_PI * time / period_ms);
    double velocity2 = max_velocity * sin(2.0 * M_PI * time / period_ms + M_PI);  // 180 degrees out of phase
    
    // Send velocity commands
    Moteus::PositionMode::Command pos_cmd1;
    pos_cmd1.position = NaN;  // No position target
    pos_cmd1.velocity = velocity1 * MOTOR1_DIRECTION;
    
    Moteus::PositionMode::Command pos_cmd2;
    pos_cmd2.position = NaN;  // No position target
    pos_cmd2.velocity = velocity2 * MOTOR2_DIRECTION;
    
    moteus1.SetPosition(pos_cmd1, &position_fmt);
    moteus2.SetPosition(pos_cmd2, &position_fmt);
    
    loop_count++;
    if (loop_count % 50 == 0) {
      const auto& r1 = moteus1.last_result().values;
      const auto& r2 = moteus2.last_result().values;
      
      Serial.print(F("time="));
      Serial.print(time);
      Serial.print(F(" | M1: mpos="));
      Serial.print(r1.position, 2);
      Serial.print(F(" vel="));
      Serial.print(velocity1, 2);
      Serial.print(F(" | M2: mpos="));
      Serial.print(r2.position, 2);
      Serial.print(F(" vel="));
      Serial.println(velocity2, 2);
    }
    
    delay(10);  // 100Hz control loop
  }
}