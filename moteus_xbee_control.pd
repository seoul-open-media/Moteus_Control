#N canvas 100 100 1200 800 12;
#X text 20 20 Moteus XBee Control - Pure Data Patch;
#X text 20 40 Connect XBee to correct COM port and set baud to 115200;
#X obj 50 80 comport;
#X msg 50 60 devices;
#X text 120 60 <- Click to see available ports;
#X msg 150 80 open 0;
#X msg 230 80 close;
#X text 150 60 <- Set port number;
#X msg 310 80 baud 115200;
#X text 310 60 <- Set baud rate;
#X text 20 130 === MOTOR 1 CONTROL ===;
#X obj 50 160 hsl 256 20 -0.5 0.5 0 0 empty empty M1_Position -2 -10
0 12 -228856 -1 -1 12800 1;
#X obj 50 185 nbx 5 18 -0.5 0.5 0 0 empty empty empty 0 -10 0 12 -228856
-1 -1 0 256;
#X obj 50 210 pack f;
#X msg 50 235 M1 \$1;
#X obj 50 260 symbol;
#X obj 50 285 list append 10;
#X obj 50 310 list trim;
#X obj 50 335 comport 0;
#X text 320 160 Drag slider or type value;
#X text 20 380 === MOTOR 2 CONTROL ===;
#X obj 50 410 hsl 256 20 -0.5 0.5 0 0 empty empty M2_Position -2 -10
0 12 -228856 -1 -1 12800 1;
#X obj 50 435 nbx 5 18 -0.5 0.5 0 0 empty empty empty 0 -10 0 12 -228856
-1 -1 0 256;
#X obj 50 460 pack f;
#X msg 50 485 M2 \$1;
#X obj 50 510 symbol;
#X obj 50 535 list append 10;
#X obj 50 560 list trim;
#X obj 50 585 comport 0;
#X text 320 410 Drag slider or type value;
#X text 20 630 === BOTH MOTORS CONTROL ===;
#X obj 50 660 hsl 256 20 -0.5 0.5 0 0 empty empty M1&M2_Position -2
-10 0 12 -228856 -1 -1 12800 1;
#X obj 50 685 nbx 5 18 -0.5 0.5 0 0 empty empty empty 0 -10 0 12 -228856
-1 -1 0 256;
#X obj 50 710 pack f f;
#X msg 50 735 BOTH \$1 \$2;
#X obj 50 760 symbol;
#X obj 50 785 list append 10;
#X obj 50 810 list trim;
#X obj 50 835 comport 0;
#X text 320 660 Move both motors to same position;
#X text 500 130 === PRESET POSITIONS ===;
#X msg 520 160 M1 0 \, M2 0;
#X msg 520 190 M1 0.25 \, M2 0.25;
#X msg 520 220 M1 0.5 \, M2 0.5;
#X msg 520 250 M1 -0.25 \, M2 -0.25;
#X obj 520 280 symbol;
#X obj 520 305 list append 10;
#X obj 520 330 list trim;
#X obj 520 355 comport 0;
#X text 620 160 Zero position;
#X text 620 190 Quarter turn;
#X text 620 220 Half turn;
#X text 620 250 Negative quarter;
#X text 500 380 === EMERGENCY STOP ===;
#X msg 520 410 STOP;
#X obj 520 435 symbol;
#X obj 520 460 list append 10;
#X obj 520 485 list trim;
#X obj 520 510 comport 0;
#X text 580 410 <- EMERGENCY STOP;
#X text 500 550 === STATUS QUERY ===;
#X obj 520 580 tgl 30 0 empty empty empty 17 7 0 10 -262144 -1 -1 0
1;
#X obj 520 615 metro 1000;
#X msg 520 640 STATUS;
#X obj 520 665 symbol;
#X obj 520 690 list append 10;
#X obj 520 715 list trim;
#X obj 520 740 comport 0;
#X text 560 580 Toggle for 1Hz status updates;
#X text 800 130 === RECEIVED DATA ===;
#X obj 820 160 comport 0;
#X obj 820 185 print XBee_RX;
#X text 820 210 All received data appears in console;
#X text 800 250 === CONNECTION NOTES ===;
#X text 800 270 1. Click "devices" to see COM ports;
#X text 800 290 2. Set correct port number in "open" messages;
#X text 800 310 3. Make sure baud rate is 115200;
#X text 800 330 4. XBee modules must be paired;
#X text 800 370 === COMMAND FORMAT ===;
#X text 800 390 M1 <value> - Move motor 1;
#X text 800 410 M2 <value> - Move motor 2;
#X text 800 430 BOTH <val1> <val2> - Move both;
#X text 800 450 STOP - Emergency stop;
#X text 800 470 STATUS - Query positions;
#X text 800 510 Position range: -0.5 to 0.5 revolutions;
#X connect 2 0 0 0;
