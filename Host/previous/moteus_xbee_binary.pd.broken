#N canvas 1874 1244 900 700 12;
#X text 50 20 Binary XBee Motor Control - WORKING VERSION;
#X text 50 50 === MOTOR 1 ===;
#X obj 80 80 hsl 200 15 -0.5 0.5 0 0 empty empty M1 -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 80 100 nbx 8 14 -0.5 0.5 0 0 empty empty empty 0 -8 0 10 #fcfcfc #000000 #000000 0 256;
#X obj 80 125 speedlim 100;
#X obj 80 150 * 65535;
#X obj 80 155 int;
#X obj 80 180 t f f;
#X obj 80 205 >> 8;
#X obj 150 205 & 255;
#X obj 80 230 & 255;
#X obj 150 230 & 255;
#X obj 80 255 pack f f;
#X msg 80 280 255 1 \$1 \$2;
#X obj 80 305 s motor_cmd;
#X text 300 80 Move slider for Motor 1;
#X text 50 350 === MOTOR 2 ===;
#X obj 80 380 hsl 200 15 -0.5 0.5 0 0 empty empty M2 -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 80 400 nbx 8 14 -0.5 0.5 0 0 empty empty empty 0 -8 0 10 #fcfcfc #000000 #000000 0 256;
#X obj 80 425 speedlim 100;
#X obj 80 450 * 65535;
#X obj 80 455 int;
#X obj 80 480 t f f;
#X obj 80 505 >> 8;
#X obj 150 505 & 255;
#X obj 80 530 & 255;
#X obj 150 530 & 255;
#X obj 80 555 pack f f;
#X msg 80 580 255 2 \$1 \$2;
#X obj 80 605 s motor_cmd;
#X text 300 380 Move slider for Motor 2;
#X text 500 50 === STOP ===;
#X msg 520 80 255 4;
#X obj 520 105 s motor_cmd;
#X text 500 150 === PRESETS ===;
#X msg 520 180 255 1 0 0;
#X msg 520 205 255 1 63 255;
#X msg 520 230 255 1 127 255;
#X msg 520 280 255 2 0 0;
#X msg 520 305 255 2 63 255;
#X msg 520 330 255 2 127 255;
#X obj 520 360 s motor_cmd;
#X text 650 180 M1 = 0;
#X text 650 205 M1 = 0.125;
#X text 650 230 M1 = 0.25;
#X text 650 280 M2 = 0;
#X text 650 305 M2 = 0.125;
#X text 650 330 M2 = 0.25;
#X text 50 640 COMPORT ->;
#N canvas 1332 299 500 400 send 1;
#X obj 100 50 r motor_cmd;
#X msg 200 100 devices;
#X msg 200 130 open 1;
#X msg 200 160 close;
#X obj 100 250 print RX;
#X obj 100 200 comport 35 115200;
#X connect 0 0 5 0;
#X connect 1 0 5 0;
#X connect 2 0 5 0;
#X connect 3 0 5 0;
#X connect 5 0 4 0;
