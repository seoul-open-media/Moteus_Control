#X text 20 630 === BOTH MOTORS CONTROL ===;
#X obj 50 660 hsl 256 20 -0.5 0.5 0 0 empty empty M1&M2_Position -2 -10 0 12 #dcdcdc #000000 #000000 0 1;
#X obj 50 685 nbx 5 18 -0.5 0.5 0 0 empty empty empty 0 -10 0 12 #dcdcdc #000000 #000000 0 256;
