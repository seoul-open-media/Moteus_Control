#X msg 50 735 BOTH \$1 \$2;
#X obj 50 760 symbol;
#X obj 50 785 list append 10;
#X obj 50 810 list trim;
#X text 320 660 Move both motors to same position;
#X text 500 130 === PRESET POSITIONS ===;
#X msg 520 160 M1 0 \, M2 0;
#X msg 520 190 M1 0.25 \, M2 0.25;
#X msg 520 220 M1 0.5 \, M2 0.5;
#X msg 520 250 M1 -0.25 \, M2 -0.25;
#X obj 520 280 symbol;
#X obj 520 305 list append 10;
#X obj 520 330 list trim;
#X text 620 160 Zero position;
#X text 620 190 Quarter turn;
#X text 620 220 Half turn;
#X text 620 250 Negative quarter;
