#X text 560 580 Toggle for 1Hz status updates;
#X text 800 130 === RECEIVED DATA ===;
#X obj 820 185 print XBee_RX;
#X text 820 210 All received data appears in console;
#X text 800 250 === CONNECTION NOTES ===;
#X text 800 270 Port configured: ttyUSB_Xbee at 115200 baud;
#X text 800 290 Click "open ttyUSB_Xbee" to connect;
#X text 800 310 Click "devices" to see all available ports;
#X text 800 330 XBee modules must be paired (transparent mode);
#X text 800 370 === COMMAND FORMAT ===;
#X text 800 390 M1 <value> - Move motor 1;
#X text 800 410 M2 <value> - Move motor 2;
#X text 800 430 BOTH <val1> <val2> - Move both;
#X text 800 450 STOP - Emergency stop;
#X text 800 470 STATUS - Query positions;
#X text 800 510 Position range: -0.5 to 0.5 revolutions;
